# Salin berkas ini menjadi .env.local lalu sesuaikan.

# ---------------------------------------------------------------------------
# DATABASE_URL menentukan database mana yang dipakai.
#
#   Dikosongkan  -> database lokal berupa berkas di ./data/rental (PGlite).
#                   Tanpa mendaftar layanan apa pun, tanpa internet.
#                   Cocok untuk mencoba dan mengembangkan.
#
#   postgresql:// -> Neon atau Postgres lain. Wajib untuk deploy ke Vercel,
#                   karena penyimpanan berkas di sana tidak permanen.
#
# Contoh isian Neon (ambil yang "Pooled connection"):
#   DATABASE_URL="postgresql://user:sandi@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# ---------------------------------------------------------------------------
DATABASE_URL=""

# Kunci penandatangan cookie sesi. Buat acak, minimal 32 karakter, jangan dibagikan.
# Cara membuat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
